# MongoDB Atlas connection string
# Replace <username>, <password>, and <cluster-url> with your actual Atlas values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?appName=<appName>

# Express server port
PORT=5000

# Allowed frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Environment
NODE_ENV=development
